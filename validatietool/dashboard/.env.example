# Voeg desgewenst toe aan Analysis/.env of zet als procesvariabelen.
# AB_* heeft voorrang op legacy sleutels. Dit bestand wordt niet automatisch geladen.
AB_DB_HOST=
AB_DB_PORT=25060
AB_DB_USER=
AB_DB_PASSWORD=
AB_DB_SSLMODE=require
AB_REGISTER_DATABASE=admin_burden_classifications
AB_CORPUS_DATABASE=riavectors
AB_QUERY_TIMEOUT_MS=30000
